<?xml version='1.0' ?>
<!--
  omx_02 · OMX-02 (설치 로봇)
  rmf_control_ui 가 맵 프로젝트에서 생성했다.

  이 로봇 한 대만 Gazebo 에 올린다. 월드는 이미 떠 있다고 본다.

  값의 출처: Gazebo 시뮬레이션
  프로젝트 bringup 이 이 파일을 include 한다.

  혼자 시험하려면:
    ros2 launch <이 파일>
-->
<launch>
  <group>
    <push-ros-namespace namespace="omx_02"/>
    <node pkg="robot_state_publisher"
          exec="robot_state_publisher" output="screen">
      <param name="use_sim_time" value="True"/>
      <param name="frame_prefix" value="omx_02/"/>
      <param name="robot_description"
             value="$(command '$(dirname)/robot_description.sh')"/>
    </node>
    <node pkg="ros_gz_sim" exec="create" output="screen"
          args="-name omx_02 -topic robot_description -x 0.409 -y -2.187 -z 0.0 -Y 0.000 -allow_renaming true">
      <param name="use_sim_time" value="True"/>
    </node>
    <!-- 팔은 ros2_control 컨트롤러가 움직인다. -->
    <node pkg="controller_manager" exec="spawner"
          args="joint_state_broadcaster" output="screen"/>
    <node pkg="controller_manager" exec="spawner"
          args="arm_controller" output="screen"/>
    <node pkg="controller_manager" exec="spawner"
          args="gripper_controller" output="screen"/>
  </group>
</launch>
