<?xml version='1.0' ?>
<!--
  gwanghee 프로젝트의 Gazebo bringup.
  rmf_control_ui 가 맵 프로젝트에서 생성했다.

  월드는 배포 산출물을 쓰고, 로봇은 이 프로젝트에 등록된 것만
  올린다. 로봇마다 네임스페이스를 나눠 토픽을 구분한다.
-->
<launch>
  <arg name="headless" default="true"/>
  <arg name="map_dir" default="/home/gyi/robosapiens/rmf_maps/gwanghee"/>
  <arg name="world" default="$(var map_dir)/gwanghee.world"/>
  <arg name="bridge_params" default="$(var map_dir)/gwanghee_gz_bridge.yaml"/>

  <set_env name="GZ_SIM_RESOURCE_PATH"
           value="$(find-pkg-share pinky_description)/../:$(find-pkg-share open_manipulator_description)/../:$(var map_dir)/generated_models:$(env HOME)/.gazebo/models"/>

  <!-- 화면이 없는 환경에서는 headless 로 서버만 띄운다.
       헤드리스 렌더링이 있어야 라이다·카메라가 돈다.
       gpu_lidar 는 GPU 로 거리를 재므로 그릴 자리가 없으면
       아무것도 발행하지 않는다. 오류도 나지 않는다. -->
  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args" value="-r -s -v2 --headless-rendering $(var world)"/>
    <arg name="on_exit_shutdown" value="true"/>
  </include>
  <group unless="$(var headless)">
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
      <arg name="gz_args" value="-g -v2"/>
    </include>
  </group>

  <!-- OMX-01 · 매니퓰레이터 1호 · 설치 로봇 @ OMX1 -->
  <include file="$(var map_dir)/robots/OMX-01/spawn.launch.xml"/>

  <!-- OMX-02 · 매니퓰레이터 2호 · 설치 로봇 @ OMX2 -->
  <include file="$(var map_dir)/robots/OMX-02/spawn.launch.xml"/>

  <!-- PK_03 · 핑키 3호 · 이동 로봇 @ 충전1 -->
  <include file="$(var map_dir)/robots/PK_03/spawn.launch.xml"/>

  <!-- 다리는 하나로 묶는다. 설정에 이름이 절대 경로로 적혀
       있어 로봇이 몇 대든 겹치지 않는다. -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge"
        name="gz_bridge" output="screen"
        args="--ros-args -p config_file:=$(var bridge_params)"/>
</launch>
