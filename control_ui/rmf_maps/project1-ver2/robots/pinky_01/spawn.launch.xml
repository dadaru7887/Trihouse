<?xml version='1.0' ?>
<!--
  pinky_01 · PK-01 (이동 로봇)
  rmf_control_ui 가 맵 프로젝트에서 생성했다.

  이 로봇 한 대만 Gazebo 에 올린다. 월드는 이미 떠 있다고 본다.

  값의 출처: Gazebo 시뮬레이션
  프로젝트 bringup 이 이 파일을 include 한다.

  혼자 시험하려면:
    ros2 launch <이 파일>
-->
<launch>
  <group>
    <push-ros-namespace namespace="pinky_01"/>
    <node pkg="robot_state_publisher"
          exec="robot_state_publisher"
          name="robot_state_publisher" output="screen">
      <param name="use_sim_time" value="True"/>
      <param name="ignore_timestamp" value="False"/>
      <param name="frame_prefix" value="pinky_01/"/>
      <param name="robot_description" value="$(command '$(dirname)/robot_description.sh')"/>
    </node>
    <node pkg="joint_state_publisher"
          exec="joint_state_publisher"
          name="joint_state_publisher" output="screen">
      <param name="use_sim_time" value="True"/>
      <param name="rate" value="20.0"/>
      <param name="source_list" value="[joint_states]"/>
    </node>
    <node pkg="ros_gz_sim" exec="create" output="screen"
          args="-name pinky_01 -topic /pinky_01/robot_description -x 1.613 -y -1.088 -z 0.1 -Y 0.000">
      <param name="use_sim_time" value="True"/>
    </node>
  </group>
</launch>
