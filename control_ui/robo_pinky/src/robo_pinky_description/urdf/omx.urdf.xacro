<?xml version="1.0"?>
<!--
  OpenMANIPULATOR-X 적재 로봇팔 (구획 적재 스테이션용).

  관절 원점·축·가동범위는 ROBOTIS `open_manipulator_description`의
  open_manipulator_x와 동일하다. 시각 형상만 메시 대신 기본 도형으로
  재구성해 저장소를 자체 완결적으로 유지한다(Pinky와 같은 방침).

    joint1  z축 회전   ±180°      base    → link2
    joint2  y축 회전   ±86°       link2   → link3
    joint3  y축 회전   -86°~80°   link3   → link4
    joint4  y축 회전   -97°~113°  link4   → link5
    gripper_left/right  직동 -0.011~0.02 m

  받침대 위에 세워 월드에 고정되며, 관절은 gz JointPositionController가
  `/<arm_name>/<joint>_cmd` (std_msgs/Float64) 하나씩 구동한다.
-->
<robot name="omx" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="arm_name" default="omx_a"/>
  <xacro:arg name="body_color" default="0.90 0.90 0.92 1.0"/>
  <!-- 받침대 높이. 로봇 적재 데크(z≈0.076 m)를 내려다볼 수 있어야 한다. -->
  <xacro:arg name="pedestal_height" default="0.18"/>

  <xacro:property name="ns" value="$(arg arm_name)"/>
  <xacro:property name="prefix" value="$(arg arm_name)/"/>
  <xacro:property name="ped_h" value="$(arg pedestal_height)"/>

  <xacro:include filename="inertial_macros.xacro"/>

  <material name="omx_body"><color rgba="$(arg body_color)"/></material>
  <material name="omx_joint"><color rgba="0.18 0.19 0.22 1.0"/></material>
  <material name="omx_pedestal"><color rgba="0.35 0.37 0.42 1.0"/></material>
  <material name="omx_bin"><color rgba="0.80 0.55 0.22 1.0"/></material>

  <!-- ─────────────────────────────────────────── 월드 고정 받침대 -->

  <link name="world"/>

  <joint name="${prefix}world_fixed" type="fixed">
    <parent link="world"/>
    <child link="${prefix}pedestal"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}pedestal">
    <visual>
      <origin xyz="0 0 ${ped_h/2}" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 ${ped_h}"/></geometry>
      <material name="omx_pedestal"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${ped_h/2}" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 ${ped_h}"/></geometry>
    </collision>
    <xacro:inertial_box mass="4.0" x="0.06" y="0.06" z="${ped_h}">
      <origin xyz="0 0 ${ped_h/2}" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- 팔이 집어 올리는 화물이 놓이는 자리(시각 표시).
       받침대·화물대는 통로를 침범하지 않도록 최소 단면으로 둔다. -->
  <joint name="${prefix}bin_fixed" type="fixed">
    <parent link="${prefix}pedestal"/>
    <child link="${prefix}bin"/>
    <origin xyz="-0.19 0 ${ped_h - 0.03}" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}bin">
    <visual>
      <geometry><box size="0.10 0.10 0.05"/></geometry>
      <material name="omx_bin"/>
    </visual>
    <collision>
      <geometry><box size="0.10 0.10 0.05"/></geometry>
    </collision>
    <xacro:inertial_box mass="1.5" x="0.10" y="0.10" z="0.05">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="${prefix}base_fixed" type="fixed">
    <parent link="${prefix}pedestal"/>
    <child link="${prefix}link1"/>
    <origin xyz="0 0 ${ped_h}" rpy="0 0 0"/>
  </joint>

  <!-- ─────────────────────────────────────────── 팔 -->

  <link name="${prefix}link1">
    <visual>
      <origin xyz="0 0 0.0125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.037" length="0.025"/></geometry>
      <material name="omx_joint"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.037" length="0.025"/></geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.0791" length="0.025" radius="0.037">
      <origin xyz="0 0 0.0125" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="${prefix}joint1" type="revolute">
    <parent link="${prefix}link1"/>
    <child link="${prefix}link2"/>
    <origin xyz="0.012 0.0 0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit velocity="4.8" effort="1000" lower="${-pi}" upper="${pi}"/>
  </joint>

  <link name="${prefix}link2">
    <visual>
      <origin xyz="0 0 0.030" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.060"/></geometry>
      <material name="omx_body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.030" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.060"/></geometry>
    </collision>
    <xacro:inertial_box mass="0.0984" x="0.05" y="0.05" z="0.060">
      <origin xyz="0 0 0.030" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="${prefix}joint2" type="revolute">
    <parent link="${prefix}link2"/>
    <child link="${prefix}link3"/>
    <origin xyz="0.0 0.0 0.0595" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="4.8" effort="1000" lower="${-1.5}" upper="${1.5}"/>
  </joint>

  <!-- 상완: (0,0,0) → (0.024, 0, 0.128), 길이 0.1302 -->
  <link name="${prefix}link3">
    <visual>
      <origin xyz="0.012 0 0.064" rpy="0 0.1855 0"/>
      <geometry><box size="0.038 0.042 0.1302"/></geometry>
      <material name="omx_body"/>
    </visual>
    <collision>
      <origin xyz="0.012 0 0.064" rpy="0 0.1855 0"/>
      <geometry><box size="0.038 0.042 0.1302"/></geometry>
    </collision>
    <xacro:inertial_box mass="0.1385" x="0.038" y="0.042" z="0.1302">
      <origin xyz="0.012 0 0.064" rpy="0 0.1855 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="${prefix}joint3" type="revolute">
    <parent link="${prefix}link3"/>
    <child link="${prefix}link4"/>
    <origin xyz="0.024 0 0.128" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="4.8" effort="1000" lower="${-1.5}" upper="${1.4}"/>
  </joint>

  <!-- 전완: (0,0,0) → (0.124, 0, 0) -->
  <link name="${prefix}link4">
    <visual>
      <origin xyz="0.062 0 0" rpy="0 ${pi/2} 0"/>
      <geometry><box size="0.034 0.038 0.124"/></geometry>
      <material name="omx_body"/>
    </visual>
    <collision>
      <origin xyz="0.062 0 0" rpy="0 ${pi/2} 0"/>
      <geometry><box size="0.034 0.038 0.124"/></geometry>
    </collision>
    <xacro:inertial_box mass="0.1327" x="0.034" y="0.038" z="0.124">
      <origin xyz="0.062 0 0" rpy="0 ${pi/2} 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="${prefix}joint4" type="revolute">
    <parent link="${prefix}link4"/>
    <child link="${prefix}link5"/>
    <origin xyz="0.124 0.0 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit velocity="4.8" effort="1000" lower="${-1.7}" upper="${1.97}"/>
  </joint>

  <!-- 손목 + 그리퍼 베이스 -->
  <link name="${prefix}link5">
    <visual>
      <origin xyz="0.041 0 0" rpy="0 ${pi/2} 0"/>
      <geometry><box size="0.032 0.048 0.082"/></geometry>
      <material name="omx_joint"/>
    </visual>
    <collision>
      <origin xyz="0.041 0 0" rpy="0 ${pi/2} 0"/>
      <geometry><box size="0.032 0.048 0.082"/></geometry>
    </collision>
    <xacro:inertial_box mass="0.1433" x="0.032" y="0.048" z="0.082">
      <origin xyz="0.041 0 0" rpy="0 ${pi/2} 0"/>
    </xacro:inertial_box>
  </link>

  <xacro:macro name="finger" params="side y_sign">
    <joint name="${prefix}gripper_${side}_joint" type="prismatic">
      <parent link="${prefix}link5"/>
      <child link="${prefix}gripper_${side}_link"/>
      <origin xyz="0.0817 ${y_sign * 0.021} 0.0" rpy="0 0 0"/>
      <axis xyz="0 ${y_sign} 0"/>
      <limit velocity="4.8" effort="1000" lower="-0.011" upper="0.02"/>
    </joint>

    <link name="${prefix}gripper_${side}_link">
      <visual>
        <origin xyz="0.022 0 0" rpy="0 0 0"/>
        <geometry><box size="0.044 0.010 0.020"/></geometry>
        <material name="omx_joint"/>
      </visual>
      <collision>
        <origin xyz="0.022 0 0" rpy="0 0 0"/>
        <geometry><box size="0.044 0.010 0.020"/></geometry>
      </collision>
      <xacro:inertial_box mass="0.010" x="0.044" y="0.010" z="0.020">
        <origin xyz="0.022 0 0" rpy="0 0 0"/>
      </xacro:inertial_box>
    </link>
  </xacro:macro>

  <xacro:finger side="left" y_sign="1"/>
  <xacro:finger side="right" y_sign="-1"/>

  <link name="${prefix}end_effector_link"/>

  <joint name="${prefix}end_effector_joint" type="fixed">
    <parent link="${prefix}link5"/>
    <child link="${prefix}end_effector_link"/>
    <origin xyz="0.126 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- ─────────────────────────────────────────── Gazebo -->

  <gazebo>
    <!--
      관절마다 위치 컨트롤러를 하나씩 둔다. `use_velocity_commands`를 켜면
      컨트롤러가 힘이 아니라 관절 속도를 직접 지령하므로, 가벼운 링크에서도
      중력에 밀리지 않고 지령각을 정확히 유지한다(힘 기반 PID로는 관절마다
      0.15~0.27 rad의 정상 상태 오차가 남았다).

      매끄러운 동작은 에이전트가 20 Hz로 목표각을 보간해 만들어 낸다.
    -->
    <xacro:macro name="joint_controller" params="joint gain init">
      <plugin filename="gz-sim-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>${prefix}${joint}</joint_name>
        <topic>/${ns}/${joint}_cmd</topic>
        <use_velocity_commands>true</use_velocity_commands>
        <p_gain>${gain}</p_gain>
        <initial_position>${init}</initial_position>
      </plugin>
    </xacro:macro>

    <xacro:joint_controller joint="joint1" gain="12.0" init="0.0"/>
    <xacro:joint_controller joint="joint2" gain="12.0" init="-0.292"/>
    <xacro:joint_controller joint="joint3" gain="12.0" init="0.375"/>
    <xacro:joint_controller joint="joint4" gain="12.0" init="0.817"/>
    <xacro:joint_controller joint="gripper_left_joint" gain="25.0" init="0.019"/>
    <xacro:joint_controller joint="gripper_right_joint" gain="25.0" init="0.019"/>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/${ns}/joint_states</topic>
      <joint_name>${prefix}joint1</joint_name>
      <joint_name>${prefix}joint2</joint_name>
      <joint_name>${prefix}joint3</joint_name>
      <joint_name>${prefix}joint4</joint_name>
      <joint_name>${prefix}gripper_left_joint</joint_name>
      <joint_name>${prefix}gripper_right_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
