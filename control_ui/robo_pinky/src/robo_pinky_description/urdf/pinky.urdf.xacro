<?xml version="1.0"?>
<!--
  Pinky 차동구동 로봇 (관제센터 연동용).

  치수는 PinkLab Pinky 실기와 동일하다(섀시 100×80×60 mm, 바퀴 ø60 mm,
  축간 110 mm, 캐스터 ø20 mm). 메시 대신 기본 도형만 사용하므로 여러 대를
  동시에 스폰해도 로딩이 가볍다.

  robot_name 마다 링크 이름과 gz 토픽이 분리되므로 한 월드에 N대를 띄울 수 있다.
    링크/프레임 : <robot_name>/base_footprint ...
    gz 토픽     : /<robot_name>/cmd_vel · /odom · /scan · /imu · /tf
-->
<robot name="pinky" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="robot_name" default="pinky_01"/>
  <xacro:arg name="body_color" default="0.98 0.42 0.65 1.0"/>

  <!-- 카메라는 대수만큼 GPU 렌더 패스를 잡아먹는다. 관제 링크는 라이다만
       쓰므로 기본은 꺼 두고, 영상이 필요할 때만 켠다. -->
  <xacro:arg name="enable_camera" default="false"/>

  <xacro:property name="ns" value="$(arg robot_name)"/>
  <xacro:property name="prefix" value="$(arg robot_name)/"/>

  <xacro:include filename="inertial_macros.xacro"/>

  <!-- 실기 치수 -->
  <xacro:property name="chassis_length" value="0.10"/>
  <xacro:property name="chassis_width" value="0.08"/>
  <xacro:property name="chassis_height" value="0.06"/>
  <xacro:property name="chassis_mass" value="1.0"/>
  <xacro:property name="wheel_separation" value="0.11"/>
  <xacro:property name="wheel_radius" value="0.03"/>
  <xacro:property name="wheel_thickness" value="0.014"/>
  <xacro:property name="wheel_mass" value="0.05"/>
  <xacro:property name="caster_radius" value="0.01"/>
  <xacro:property name="caster_mass" value="0.10"/>

  <material name="pinky_body"><color rgba="$(arg body_color)"/></material>
  <material name="pinky_dark"><color rgba="0.15 0.15 0.18 1.0"/></material>
  <material name="pinky_lidar"><color rgba="0.20 0.22 0.28 1.0"/></material>
  <material name="pinky_lens"><color rgba="0.10 0.35 0.75 1.0"/></material>
  <material name="pinky_deck"><color rgba="0.92 0.92 0.95 1.0"/></material>

  <!-- ───────────────────────────────────────────────── 본체 -->

  <link name="${prefix}base_footprint"/>

  <joint name="${prefix}base_link_fixed_joint" type="fixed">
    <parent link="${prefix}base_footprint"/>
    <child link="${prefix}base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}base_link"/>

  <joint name="${prefix}chassis_fixed_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}chassis"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}chassis">
    <visual>
      <origin xyz="-0.01 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="pinky_body"/>
    </visual>
    <!-- 상판(적재 데크) -->
    <visual>
      <origin xyz="-0.01 0 0.042" rpy="0 0 0"/>
      <geometry><box size="0.09 0.075 0.004"/></geometry>
      <material name="pinky_deck"/>
    </visual>
    <collision>
      <origin xyz="-0.01 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}"
                        y="${chassis_width}" z="${chassis_height}">
      <origin xyz="-0.01 0 0.01" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="${prefix}caster_fixed_joint" type="fixed">
    <parent link="${prefix}chassis"/>
    <child link="${prefix}caster"/>
    <origin xyz="-0.044 0 -0.02" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}caster">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="pinky_dark"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_sphere>
  </link>

  <!-- ───────────────────────────────────────────────── 구동륜 -->

  <xacro:macro name="drive_wheel" params="side reflect axis_z">
    <joint name="${prefix}${side}_wheel_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}${side}_wheel"/>
      <origin xyz="0 ${reflect * wheel_separation / 2} 0"
              rpy="${reflect * -pi/2} 0 0"/>
      <axis xyz="0 0 ${axis_z}"/>
    </joint>

    <link name="${prefix}${side}_wheel">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
        </geometry>
        <material name="pinky_dark"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
        </geometry>
      </collision>
      <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}"
                               radius="${wheel_radius}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>
  </xacro:macro>

  <xacro:drive_wheel side="left" reflect="1" axis_z="1"/>
  <xacro:drive_wheel side="right" reflect="-1" axis_z="-1"/>

  <!-- ───────────────────────────────────────────────── 센서 -->

  <!-- 2D 라이다 (LD06 상당) -->
  <joint name="${prefix}lidar_mount_fixed_joint" type="fixed">
    <parent link="${prefix}chassis"/>
    <child link="${prefix}lidar_mount"/>
    <origin xyz="0 0 0.052" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}lidar_mount">
    <visual>
      <origin xyz="0 0 0.012" rpy="0 0 0"/>
      <geometry><cylinder radius="0.019" length="0.024"/></geometry>
      <material name="pinky_lidar"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.012" rpy="0 0 0"/>
      <geometry><cylinder radius="0.019" length="0.024"/></geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.06" length="0.024" radius="0.019">
      <origin xyz="0 0 0.012" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <link name="${prefix}laser_link"/>

  <joint name="${prefix}laser_link_fixed_joint" type="fixed">
    <parent link="${prefix}lidar_mount"/>
    <child link="${prefix}laser_link"/>
    <origin xyz="0 0 0.020" rpy="0 0 0"/>
  </joint>

  <!-- 전방 카메라 -->
  <joint name="${prefix}camera_mount_fixed_joint" type="fixed">
    <parent link="${prefix}chassis"/>
    <child link="${prefix}camera_mount"/>
    <origin xyz="0.042 0 0.028" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}camera_mount">
    <visual>
      <geometry><box size="0.008 0.024 0.016"/></geometry>
      <material name="pinky_lens"/>
    </visual>
    <xacro:inertial_box mass="0.02" x="0.008" y="0.024" z="0.016">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <link name="${prefix}camera_link"/>

  <joint name="${prefix}camera_link_fixed_joint" type="fixed">
    <parent link="${prefix}camera_mount"/>
    <child link="${prefix}camera_link"/>
    <origin xyz="0.005 0 0" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}imu_link"/>

  <joint name="${prefix}imu_link_fixed_joint" type="fixed">
    <parent link="${prefix}chassis"/>
    <child link="${prefix}imu_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <!-- ───────────────────────────────────────────────── Gazebo -->

  <gazebo reference="${prefix}left_wheel">
    <mu1 value="1.2"/><mu2 value="1.2"/>
  </gazebo>
  <gazebo reference="${prefix}right_wheel">
    <mu1 value="1.2"/><mu2 value="1.2"/>
  </gazebo>
  <gazebo reference="${prefix}caster">
    <mu1 value="0.01"/><mu2 value="0.01"/>
  </gazebo>
  <gazebo reference="${prefix}chassis">
    <mu1 value="0.01"/><mu2 value="0.01"/>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>${prefix}left_wheel_joint</left_joint>
      <right_joint>${prefix}right_wheel_joint</right_joint>
      <wheel_separation>0.096</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <min_velocity>-0.5</min_velocity>
      <max_velocity>0.5</max_velocity>
      <min_acceleration>-2.0</min_acceleration>
      <max_acceleration>2.0</max_acceleration>

      <topic>/${ns}/cmd_vel</topic>
      <odom_topic>/${ns}/odom</odom_topic>
      <tf_topic>/${ns}/tf</tf_topic>
      <frame_id>${prefix}odom</frame_id>
      <child_frame_id>${prefix}base_footprint</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/${ns}/joint_states</topic>
      <joint_name>${prefix}left_wheel_joint</joint_name>
      <joint_name>${prefix}right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <gazebo reference="${prefix}laser_link">
    <sensor name="laser" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>/${ns}/scan</topic>
      <gz_frame_id>${prefix}laser_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>6.0</max>
          <resolution>0.02</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg enable_camera)">
    <gazebo reference="${prefix}camera_link">
      <sensor name="camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/${ns}/camera/image_raw</topic>
        <gz_frame_id>${prefix}camera_link</gz_frame_id>
        <camera name="pinky_camera">
          <camera_info_topic>/${ns}/camera/camera_info</camera_info_topic>
          <horizontal_fov>1.08</horizontal_fov>
          <image><width>640</width><height>360</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>50</far></clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>

  <gazebo reference="${prefix}imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/${ns}/imu</topic>
      <gz_frame_id>${prefix}imu_link</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
