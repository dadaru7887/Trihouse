ARG BASE_IMAGE=pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime
FROM ${BASE_IMAGE}

WORKDIR /opt/trihouse
ENV PYTHONPATH=/opt/trihouse \
    YOLO_CONFIG_DIR=/tmp/ultralytics

COPY docker/ai/requirements.inference.txt /tmp/requirements.inference.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.inference.txt
# EN: Ultralytics pulls GUI OpenCV; restore the headless wheel after resolution.
# KO: Ultralytics가 GUI OpenCV를 설치하므로 의존성 해석 뒤 headless wheel로 복원한다.
RUN python -m pip uninstall -y opencv-python \
    && python -m pip install --no-cache-dir --force-reinstall --no-deps \
       opencv-python-headless==4.11.0.86

# EN: The robot image carries the runtime and the model definitions it loads
#     weights into -- never a trainer. `vision_ai/tests/recovery/
#     test_inference_boundary.py` enforces that separation in code; this COPY
#     list is where it becomes a property of the shipped image.
# KO: 로봇 이미지는 런타임과 그 런타임이 가중치를 싣는 모델 정의만 담는다 —
#     trainer 는 담지 않는다. 코드 상 경계는 위 테스트가 지키고, 이미지에
#     실제로 안 들어간다는 것은 이 COPY 목록이 정한다.
COPY vision_ai/__init__.py vision_ai/__init__.py
COPY vision_ai/utils vision_ai/utils
COPY vision_ai/robot vision_ai/robot
COPY vision_ai/models/__init__.py vision_ai/models/__init__.py
COPY vision_ai/models/perception/__init__.py vision_ai/models/perception/__init__.py
COPY vision_ai/models/perception/detector.py vision_ai/models/perception/detector.py
COPY vision_ai/models/perception/features.py vision_ai/models/perception/features.py
COPY vision_ai/models/perception/fall_classifier.py vision_ai/models/perception/fall_classifier.py
COPY vision_ai/models/recovery/__init__.py vision_ai/models/recovery/__init__.py
COPY vision_ai/models/recovery/policy_architecture.py vision_ai/models/recovery/policy_architecture.py
COPY vision_ai/models/recovery/distilled_selector.py vision_ai/models/recovery/distilled_selector.py
COPY vision_ai/models/recovery/vlm_interpreter.py vision_ai/models/recovery/vlm_interpreter.py
COPY vision_ai/models/recovery/checkpoint.py vision_ai/models/recovery/checkpoint.py

CMD ["python", "-m", "vision_ai.robot.recovery.runtime"]
