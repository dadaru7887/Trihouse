FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3-pip libgl1 libglib2.0-0 && \
    rm -rf /var/lib/apt/lists/*

COPY docker/omx/requirements.lerobot.txt /tmp/requirements.txt
RUN python3.10 -m pip install --no-cache-dir -r /tmp/requirements.txt

WORKDIR /opt/trihouse
COPY trihouse_omx_hardware ./trihouse_omx_hardware
COPY config/omx_product_policies.yaml ./config/omx_product_policies.yaml

ENV PYTHONPATH=/opt/trihouse
CMD ["python3.10", "-m", "trihouse_omx_hardware.worker_server"]
