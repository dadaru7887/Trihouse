<?xml version="1.0"?>
<!--
  P0 시뮬레이션 world. `pinky_gz_sim/worlds/empty.world` 의 사본이며 물리 설정만
  낮췄다. 벤더 경로(`pinky_pro/**`)는 읽기 전용이라 거기서 고칠 수 없다.

  왜 낮추는가. 12코어 개발 PC 에서 로봇 한 대를 띄웠는데도 load average 50,
  real-time factor 0.19 였다. 그 속도에서는 Open-RMF 의 스케줄 동기화가 20초마다
  타임아웃하고, 상태 갱신이 한 번 늦으면 fleet adapter 가 로봇을 decommission 해
  배정된 작업이 떨어져 나간다. 실제로 job 7 의 step 20 이 그렇게 dead_letter 가 됐다.

  무엇을 바꿨는가 (벤더 원본 -> 이 파일):

    real_time_update_rate   1000.0 -> 250.0     초당 물리 스텝
    max_step_size            0.001 -> 0.004     한 스텝의 시간. 위 값과 짝이다
    iters                      150 -> 50        스텝마다 도는 solver 반복

  근거. Pinky 의 최대 속도는 0.25 m/s 다(`pinky_fleet.yaml` limits). 250 Hz 면 한
  스텝에 1 mm 를 움직인다. 창고 주행과 정지 정확도에는 충분하고, 접촉이 복잡한
  파지·충돌 실험을 하려면 원본 값으로 되돌려야 한다.

  이 파일은 `p0_simulation_bringup.sh` 의 PINKY_WORLD 가 가리킨다.
-->
<sdf version="1.6">
  <world name="default">
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <scene>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>0.319654 -0.235002 9.29441 0 1.5138 0.009599</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>250.0</real_time_update_rate>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

  </world>
</sdf>