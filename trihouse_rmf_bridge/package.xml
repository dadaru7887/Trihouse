<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>trihouse_rmf_bridge</name>
  <version>0.1.0</version>
  <description>Connects Open-RMF fleet state and energy estimates to Trihouse.</description>
  <maintainer email="dev@trihouse.local">Trihouse Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rmf_fleet_msgs</depend>
  <depend>rmf_battery</depend>
  <depend>rmf_fleet_adapter</depend>
  <depend>rmf_traffic</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
