# MySQL development container. Copy to .env and change both passwords.
MYSQL_ROOT_PASSWORD=change_me_root
FMS_DB_DATABASE=trihouse_fms
FMS_DB_USER=fms_gateway
FMS_DB_PASSWORD=change_me_gateway
FMS_DB_HOST=127.0.0.1
FMS_DB_PORT=3306

# Gateway
FMS_API_HOST=127.0.0.1
FMS_API_PORT=8080
FMS_TIMEZONE=Asia/Seoul
FMS_DB_POOL_SIZE=5

# Local Open-RMF web support stack.
# 로봇·관제가 같은 domain 을 공유한다. 로봇 구분은 ROS namespace
# (pinky_01, pinky_02)가 맡는다. domain 을 갈라 놓으면 두 로봇이
# 서로의 토픽을 못 보고, 관제 PC 가 domain 마다 따로 붙어야 한다.
ROS_DOMAIN_ID=52
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=UDPv4
RMF_DASHBOARD_PORT=3000

# RTX 4060 media ingress/storage. Replace with the PC1 LAN address on both hosts.
PC1_LAN_IP=10.0.0.40
EDGE_BIND_ADDRESS=${PC1_LAN_IP}

# MediaMTX authorization. Publishing is restricted by source address, reading by
# account. See config/mediamtx.yml for why the two sides differ.
#
# ALL FOUR VALUES BELOW ARE PLACEHOLDERS AND MUST BE REPLACED PER DEPLOYMENT.
#
# The three addresses must be the addresses MediaMTX actually observes, which
# means each robot needs a DHCP reservation first — a lease that moves silently
# stops that robot from publishing. Verify with, on PC1:
#   docker compose -f compose.edge_4060.yaml logs mediamtx | grep -i auth
MTX_VIEWER_PASS=change_me_viewer
PINKY_PK_01_IP=192.0.2.11
PINKY_PK_02_IP=192.0.2.12
# Host that publishes the USB-attached OMX wrist and warehouse fixed cameras.
PC1_PUBLISHER_IP=192.0.2.10
TRIHOUSE_VIDEO_DIR=./runtime/video
TRIHOUSE_RECORD_SEGMENT_DURATION=60s
TRIHOUSE_RECORD_DELETE_AFTER=168h
TRIHOUSE_QR_IMAGE=trihouse_qr_worker:local
TRIHOUSE_RECORDING_IMAGE=trihouse_recording_catalog:local

# RTX 5080 AI runtime. Build or load this image on the GPU server first.
TRIHOUSE_AI_IMAGE=trihouse_ai_5080:env
TRIHOUSE_AI_SHM_SIZE=16gb
TRIHOUSE_AI_MODEL_DIR=./runtime/ai/models
TRIHOUSE_AI_DATASET_DIR=./runtime/ai/data
TRIHOUSE_AI_ARTIFACT_DIR=./runtime/ai/artifacts
TRIHOUSE_AI_QUEUE_DIR=./runtime/ai/recovery_queue
FMS_GATEWAY_URL=http://host.docker.internal:8080
# The camera identity is the final path segment of this URL; there is no separate
# VISION_CAMERA_ID. Reading requires the viewer account, so a real deployment uses
# rtsp://viewer:${MTX_VIEWER_PASS}@${PC1_LAN_IP}:8554/pinky/CAM-PK-01
VISION_RTSP_URL=rtsp://${PC1_LAN_IP}:8554/pinky/CAM-PK-01
VISION_FRAME_WIDTH=1280
VISION_FRAME_HEIGHT=720
VISION_INFERENCE_FPS=15
