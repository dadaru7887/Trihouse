# MySQL development container. Copy to .env and change both passwords.
MYSQL_ROOT_PASSWORD=change_me_root
FMS_DB_DATABASE=trihouse_fms
FMS_DB_USER=fms_gateway
FMS_DB_PASSWORD=change_me_gateway
FMS_DB_HOST=127.0.0.1
# 이 호스트에서 MySQL 을 노출하는 포트다. 컨테이너 안의 Gateway 는 이 값과 무관하게
# 네트워크 이름 `mysql:3306` 으로 붙으므로, 이것은 호스트 쪽 도구와 테스트만 쓴다.
#
# 세 MySQL 이 나란히 뜰 수 있으므로 값이 겹치면 컨테이너가 아예 시작하지 못한다
# ("port is already allocated"). 실제로 이 값을 3306 으로 두었다가 P0 의 MySQL 이
# 시작하지 못해 Gateway 가 재시작 루프에 빠졌다.
#
#   compose.db_test.yaml  3307 (고정)
#   compose.db.yaml       ${FMS_DB_PORT} — 보존되는 개발 DB
#   compose.yaml          ${FMS_DB_PORT} — P0 스택. 위와 같은 변수를 쓴다.
#
# 마지막 둘이 한 변수를 공유하므로 **동시에 띄우려면 값을 서로 다르게 주어야 한다.**
# P0 스택을 쓰는 호스트는 3308 로 둔다.
FMS_DB_PORT=3308

# Gateway
FMS_API_HOST=127.0.0.1
FMS_API_PORT=8080
FMS_TIMEZONE=Asia/Seoul
FMS_DB_POOL_SIZE=5

# P0 control stack (compose.control.yaml)
CONTROL_UI_PORT=3100
CONTROL_UI_HOST=127.0.0.1

# Local Open-RMF web support stack.
# 로봇·관제가 같은 domain 을 공유한다. 로봇 구분은 ROS namespace
# (pinky_01, pinky_02)가 맡는다. domain 을 갈라 놓으면 두 로봇이
# 서로의 토픽을 못 보고, 관제 PC 가 domain 마다 따로 붙어야 한다.
ROS_DOMAIN_ID=12
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTDDS_BUILTIN_TRANSPORTS=UDPv4
# ROS 전용 공유기의 서브넷 안에서만 서로를 찾는다. 서버 PC 는 Wi-Fi 로 인터넷에도
# 붙어 있으므로, 범위를 좁히지 않으면 그쪽으로도 discovery 를 뿌린다.
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
RMF_DASHBOARD_PORT=3000

# RTX 4060 media ingress/storage.
#
# 현재 실물 구성은 모든 PC와 로봇이 인터넷 가능한 같은 공유기 LAN에 무선으로
# 연결된다. 아래 값에는 공유기의 DHCP 예약 화면에 고정한 각 호스트 주소를 쓴다.
# 4060에서 ``ip -br address``로 확인한 주소와 예약 주소가 다르면 먼저 DHCP 임대를
# 갱신하고, ROS와 영상 서비스는 같은 LAN 주소에 바인딩한다.
PC1_LAN_IP=192.168.0.9
AI_5080_LAN_IP=192.168.0.7
EDGE_BIND_ADDRESS=${PC1_LAN_IP}

# MediaMTX authorization. Publishing is restricted by source address, reading by
# account. See config/mediamtx.yml for why the two sides differ.
#
# ALL VALUES BELOW ARE PLACEHOLDERS AND MUST BE REPLACED PER DEPLOYMENT.
#
# 주소는 MediaMTX 가 실제로 관측하는 주소여야 하므로 장비마다 DHCP 예약이 먼저다 —
# 임대가 조용히 바뀌면 그 장비만 발행에 실패한다. PC1 에서 확인:
#   docker compose -f compose.edge_4060.yaml logs mediamtx | grep -i auth
#
# 발행자마다 자기 변수를 갖는다. 둘이 한 변수를 함께 쓰면 한쪽 주소만 허용되어
# 나머지는 조용히 거절된다.
MTX_VIEWER_PASS=change_me_viewer
PINKY_PK_01_IP=192.168.0.21
PINKY_PK_02_IP=192.168.0.22
# OMX 손목 카메라를 발행하는 일반 PC. 팔이 붙어 있는 PC 가 자기 카메라를 올린다.
OMX_PC_01_IP=192.168.0.31
OMX_PC_02_IP=192.168.0.32
# 창고 고정 카메라를 USB 로 발행하는 호스트(4060).
PC1_PUBLISHER_IP=192.0.2.10
TRIHOUSE_VIDEO_DIR=./runtime/video
TRIHOUSE_RECORD_SEGMENT_DURATION=60s
TRIHOUSE_RECORD_DELETE_AFTER=168h
TRIHOUSE_QR_IMAGE=trihouse_qr_worker:local
TRIHOUSE_RECORDING_IMAGE=trihouse_recording_catalog:local

# RTX 5080 AI runtime. Build or load this image on the GPU server first.
TRIHOUSE_AI_IMAGE=trihouse_ai_5080:local
TRIHOUSE_AI_TRAINING_IMAGE=trihouse_ai_training:local
TRIHOUSE_AI_SHM_SIZE=16gb
TRIHOUSE_AI_MODEL_DIR=./runtime/ai/models
TRIHOUSE_AI_DATASET_DIR=./runtime/ai/data
TRIHOUSE_AI_ARTIFACT_DIR=./runtime/ai/artifacts
TRIHOUSE_AI_QUEUE_DIR=./runtime/ai/recovery_queue
RECOVERY_RETRY_INTERVAL_SECONDS=2
VLM_RL_TRAINING_EPOCHS=20
FMS_GATEWAY_URL=http://${PC1_LAN_IP}:8080
# The camera identity is the final path segment of this URL; there is no separate
# VISION_CAMERA_ID. Reading requires the viewer account, so a real deployment uses
# rtsp://viewer:${MTX_VIEWER_PASS}@${PC1_LAN_IP}:8554/pinky/CAM-PK-01
VISION_RTSP_URL=rtsp://${PC1_LAN_IP}:8554/pinky/CAM-PK-01
VISION_FRAME_WIDTH=1280
VISION_FRAME_HEIGHT=720
VISION_INFERENCE_FPS=15
VISION_CONFIDENCE=0.25
VISION_IMAGE_SIZE=640
VISION_PERSON_CLASS_ID=1
VISION_DEVICE=cuda:0
VLM_PROPOSAL_COOLDOWN_SECONDS=8
# DB device_id이며 ROS namespace(pinky_01)나 화면 별칭 대신 명령 라우팅에 사용한다.
RECOVERY_DEVICE_ID=PK_01
SEGMENTATION_WEIGHTS_FILE=replace_with_segmentation_weights.pt
RECOVERY_POLICY_CHECKPOINT_FILE=replace_with_approved_policy_checkpoint.pt
RECOVERY_POLICY_SHA256=replace_with_64_lowercase_hex_sha256
VLM_MODEL_REVISION=main
VLM_RL_DEVICE=cuda

# OMX PC role. Each OMX PC keeps its own .env and changes this block only.
# OMX_01 example: DEVICE_ID=OMX_01, ROS_NAMESPACE=omx_01,
# OMX_TEMPERATURE_ZONES=ambient,chilled.
# OMX_02 example: DEVICE_ID=OMX_02, ROS_NAMESPACE=omx_02,
# OMX_TEMPERATURE_ZONES=frozen.
DEVICE_ID=OMX_01
ROS_NAMESPACE=omx_01
OMX_TEMPERATURE_ZONES=ambient,chilled
# Prefer stable udev paths discovered with:
#   ls -l /dev/serial/by-id/
#   ls -l /dev/v4l/by-id/
OMX_SERIAL_DEVICE=/dev/serial/by-id/replace_with_omx_controller
OMX_FRONT_CAMERA=/dev/v4l/by-id/replace_with_front_camera-video-index0
OMX_WRIST_CAMERA=/dev/v4l/by-id/replace_with_wrist_camera-video-index0
# This ID must match the LeRobot calibration JSON filename.
OMX_CALIBRATION_ID=replace_with_lerobot_calibration_id
OMX_CALIBRATION_DIR=/home/replace_me/.cache/huggingface/lerobot/calibration/robots
OMX_MODEL_CACHE_DIR=/home/replace_me/.cache/huggingface/hub
OMX_EPISODE_STEPS=900
OMX_POLICY_FPS=15
