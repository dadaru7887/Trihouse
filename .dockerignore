!model/perception/segmentation/runtime/
!model/perception/segmentation/runtime/**
!docker/
!docker/ai/
!docker/ai/requirements.inference.txt

# Gateway 의 런타임 프로파일이 해시하는 두 개의 고정 소스
# (fms_gateway/app/runtime_profiles.py). 이게 없으면
# `/api/v1/runtime-profiles/pinky-pro-simulation` 이 500 을 내고, 지도 초안
# 저장이 profile_hash 를 못 구해 지도 발행 전체가 막힌다.
!pinky_pro/
!pinky_pro/pinky_navigation/
!pinky_pro/pinky_navigation/params/
!pinky_pro/pinky_navigation/params/nav2_params.yaml
!pinky_pro/pinky_bringup/
!pinky_pro/pinky_bringup/config/
!pinky_pro/pinky_bringup/config/pinky_params.yaml

# 관제 UI 이미지(control_ui/rmf_control_ui/Dockerfile)의 빌드 문맥.
# 호스트의 빌드 산출물은 제외한다 — 컨테이너 안에서 다시 만들고, 그대로
# 넣으면 문맥이 120MB 넘게 불어난다.
!control_ui/
!control_ui/rmf_control_ui/
!control_ui/rmf_control_ui/**
control_ui/rmf_control_ui/build/
control_ui/rmf_control_ui/.dart_tool/

# FMS Gateway 카메라 명부 의존성
!control_tower/gateway/
!control_tower/gateway/**
!config/
!config/cameras.yaml
