# Open-RMF adapter에 작업 완료 예상 SOC를 요청한다.
string robot_id
string task_id
string map_revision
# 현재 위치부터 작업 종료까지 순서대로 방문할 RMF waypoint ID.
string[] waypoint_ids
# 이동 외 작업 단계의 예상 시간(초).
float64 expected_loading_duration_s
float64 expected_handover_duration_s
float64 task_time_buffer_s
---
bool success
# RMF가 계산한 이동 시간 및 고정 단계를 포함한 전체 시간(초).
float64 travel_duration_s
float64 total_duration_s
# RMF 모델의 SOC 감소량과 종료 SOC(둘 다 0.0~1.0 단위).
float64 change_in_charge
float64 finish_state_of_charge
string reason_code
string detail
