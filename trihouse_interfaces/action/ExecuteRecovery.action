uint8 SKILL_BACKUP=0
uint8 SKILL_REROUTE_LEFT=1
uint8 SKILL_REROUTE_RIGHT=2
uint8 SKILL_WAIT_REOBSERVE=3
uint8 SKILL_REJOIN=4

string command_id
string proposal_id
string proposal_sha256
string approval_id
string approval_worker_id
string device_id
string map_name
string map_revision
string recovery_episode_uuid
uint32 step_no
uint8 selected_skill_id
string selected_skill_name
geometry_msgs/Vector3 canonical_coord
bool has_map_target
geometry_msgs/PoseStamped map_target
---
uint16 CODE_OK=0
uint16 CODE_REJECTED=1
uint16 CODE_CANCELED=2
uint16 CODE_NAV2_FAILED=3
uint16 CODE_SAFETY_VETO=4

bool success
uint16 code
string status
string detail
geometry_msgs/PoseStamped pre_pose
geometry_msgs/PoseStamped post_pose
# 진행 방향 보호 필드 안에서 몸 끝부터 잰 여유. 보상의 clearance 항이 이 값을
# 쓴다 — 옆을 스쳐 지나가는 벽까지 위험으로 세면 협로 우회가 상시 벌점을 받는다.
# -1 은 "관측되지 않음" 이고 0 은 "닿았다" 다.
float32 clearance_before_m
float32 clearance_after_m
# 방향과 무관하게 몸 경계에서 잰 최단 거리. terminal(충돌급) 판정만 이 값을 쓴다 —
# 그 판정은 어느 방향이든 몸에 닿으면 참이어야 하므로 방향을 보면 안 된다.
float32 body_clearance_after_m
float32 elapsed_seconds
bool safety_intervened
bool terminal
---
uint8 PHASE_ACCEPTED=0
uint8 PHASE_SAFETY_CHECK=1
uint8 PHASE_EXECUTING=2
uint8 PHASE_OBSERVING=3

uint8 phase
string detail
geometry_msgs/PoseStamped current_pose
float32 minimum_clearance_m
