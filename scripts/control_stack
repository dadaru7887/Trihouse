#!/usr/bin/env python3
"""P0 스택 전체를 한 명령으로 다루는 lifecycle CLI.

    ./scripts/control_stack up --mode simulation --project trihouse_test_01
    ./scripts/control_stack status
    ./scripts/control_stack logs
    ./scripts/control_stack doctor --mode simulation
    ./scripts/control_stack down

    ./scripts/control_stack ros --mode simulation

스택은 두 층으로 나뉜다.

- **Docker (`up`)**: 하나의 Compose project로 MySQL → FMS Gateway → MediaMTX
  → RMF API → RMF Dashboard → control_ui 순서로 올린다.
- **호스트 ROS 2 (`ros`)**: RMF core, Gazebo, Pinky 두 대의 Nav2와 fleet
  adapter, OMX 시뮬레이터 두 개, RMF dispatch worker.
  rclpy/DDS/GPU 가 필요해 컨테이너에 넣지 않았다.

`doctor`는 두 층을 함께 점검한다. Gazebo는 기본 headless이며 GUI/RViz는
플래그로만 켠다. `compose.ai_5080.yaml`은 시작하지 않는다. 시뮬레이션은 fake
모델 계약만 확인한다.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
COMPOSE_PROJECT = "trihouse_p0"

# P0 전용 환경 파일. 저장소 루트의 `.env` 를 쓰면 안 된다 — `compose.db.yaml`
# 의 개발용 MySQL 도 같은 `${FMS_DB_PORT}` 를 보기 때문에, P0 가 3308 을 쓰려고
# `.env` 를 고치면 개발 DB 가 다음 기동에서 같은 포트를 물고 충돌한다.
# 그래서 P0 는 `.env.p0` 만 본다. 없으면 `.env` 로 되돌아간다.
ENV_FILE = ROOT / ".env.p0"

# Docker 기동 순서. 앞의 서비스가 healthy가 된 뒤에 다음이 올라간다.
STARTUP_ORDER = (
    "mysql",
    "fms_gateway",
    "mediamtx",
    "rmf_api",
    "rmf_dashboard",
    "control_ui",
)

# 호스트 ROS 2 에서 도는 구성요소. rclpy/DDS/GPU 가 필요해 컨테이너로 옮기지
# 않았다. `control_stack ros` 가 아래 스크립트로 한 번에 띄운다.
ROS_BRINGUP = ROOT / "control_tower" / "bringup" / "p0_simulation_bringup.sh"
ROS_NODES = (
    "rmf_traffic_schedule",
    "gazebo",
    "nav2:PK_01",
    "nav2:PK_02",
    "omx:OMX_01",
    "omx:OMX_02",
    "control_tower_worker",
    "control_tower_job_runner",
    "control_tower_executor",
)

COMPOSE_FILES = (
    "compose.yaml",
    "compose.control.yaml",
    "compose.edge_4060.yaml",
    "compose.simulation.yaml",
)

# doctor가 반드시 보고해야 하는 점검 항목. Docker와 호스트 ROS 를 모두 덮는다.
REQUIRED_CHECKS = (
    "mysql",
    "fms_gateway",
    "control_tower",
    "mediamtx",
    "rmf_schedule",
    "gazebo",
    "nav2:PK_01",
    "nav2:PK_02",
    "omx:OMX_01",
    "omx:OMX_02",
    "control_ui",
    # 러너가 없으면 주문은 `queued` 에서 멈추고 outbox 가 비어 있어 로봇이
    # 움직이지 않는다. 스택이 "떠 있다"는 판정에 반드시 포함되어야 한다.
    "job_runner",
    # 실행기가 없으면 주문이 첫 `pick` 에서 멈춘다.
    "executor",
)

# Docker compose 가 책임지는 점검 항목.
DOCKER_CHECKS = {
    "mysql": "mysql",
    "fms_gateway": "fms_gateway",
    "mediamtx": "mediamtx",
    "control_ui": "control_ui",
}

# 호스트 ROS 2 가 책임지는 점검 항목 -> 확인할 ROS 노드 이름 조각.
ROS_CHECKS = {
    "control_tower": "rmf_gateway_worker",
    "job_runner": "trihouse_job_runner",
    "executor": "trihouse_executor_worker",
    "rmf_schedule": "rmf_traffic_schedule",
    # Gazebo 자체는 ROS 노드를 만들지 않는다. ROS 에서 보이는 근거는 시계와
    # TF 를 넘기는 world bridge 이고, 이 노드는 `two_pinky_order_demo.launch.py`
    # 가 Gazebo 를 띄울 때만 함께 뜬다.
    "gazebo": "trihouse_world_bridge",
    "nav2:PK_01": "pinky_01",
    "nav2:PK_02": "pinky_02",
    "omx:OMX_01": "omx_01",
    "omx:OMX_02": "omx_02",
}

# 시뮬레이션에서는 절대 켜지 않는다. 5080 AI 스택은 P1 대상이다.
FORBIDDEN_IN_SIMULATION = ("compose.ai_5080.yaml",)


def compose_command(*arguments: str, mode: str = "simulation") -> list[str]:
    """항상 같은 Compose project 이름으로 파일 묶음을 조립한다."""
    command = ["docker", "compose", "--project-name", COMPOSE_PROJECT]
    if ENV_FILE.is_file():
        command += ["--env-file", str(ENV_FILE)]
    for name in COMPOSE_FILES:
        if name in FORBIDDEN_IN_SIMULATION:
            continue
        command += ["-f", str(ROOT / name)]
    return command + list(arguments)


def _run(command: list[str], *, capture: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run(command, text=True, capture_output=capture, check=False)


def _docker_available() -> bool:
    return shutil.which("docker") is not None


def cmd_up(args: argparse.Namespace) -> int:
    if not _docker_available():
        print("docker is not available on this host", file=sys.stderr)
        return 2
    environment = dict(os.environ)
    environment["TRIHOUSE_PROJECT"] = args.project
    # 기본은 headless. GUI/RViz는 명시적 플래그로만 켠다.
    environment["TRIHOUSE_HEADLESS"] = "false" if args.gui else "true"
    environment["TRIHOUSE_RVIZ"] = "true" if args.rviz else "false"

    for service in STARTUP_ORDER:
        # compose 는 이미지가 이미 있으면 다시 빌드하지 않는다. 소스를 고친 뒤
        # `up` 만 다시 돌리면 예전 이미지가 그대로 뜨므로 `--build` 가 필요하다.
        arguments = ["up", "-d", "--wait"]
        if args.build:
            arguments.append("--build")
        completed = subprocess.run(
            compose_command(*arguments, service, mode=args.mode),
            text=True,
            env=environment,
            check=False,
        )
        if completed.returncode != 0:
            print(f"failed to start {service}", file=sys.stderr)
            return completed.returncode
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    return _run(compose_command("ps", mode=args.mode)).returncode


def cmd_logs(args: argparse.Namespace) -> int:
    arguments = ["logs", "--no-color", "--tail", str(args.tail)]
    if args.follow:
        arguments.append("--follow")
    return _run(compose_command(*arguments, mode=args.mode)).returncode


def cmd_down(args: argparse.Namespace) -> int:
    return _run(compose_command("down", "--remove-orphans", mode=args.mode)).returncode


def cmd_ros(args: argparse.Namespace) -> int:
    """호스트 ROS 2 층을 한 번에 띄운다.

    Gazebo, Pinky 두 대의 Nav2/fleet adapter, OMX 시뮬레이터 두 개, RMF
    dispatch worker가 함께 올라간다. 이 명령은 포그라운드로 돌며 Ctrl+C 로
    전체를 내린다.
    """
    if not ROS_BRINGUP.is_file():
        print(f"ROS bringup script is missing: {ROS_BRINGUP}", file=sys.stderr)
        return 2
    command = [str(ROS_BRINGUP)]
    if args.gui:
        command.append("--gui")
    if args.rviz:
        command.append("--rviz")
    environment = dict(os.environ)
    environment["TRIHOUSE_PROJECT"] = args.project
    environment["FMS_BASE_URL"] = args.fms_base_url
    return subprocess.run(command, env=environment, check=False).returncode


def cmd_doctor(args: argparse.Namespace) -> int:
    """모든 필수 구성요소의 상태를 기계가 읽을 수 있는 JSON으로 낸다."""
    running = _running_services(args.mode)
    nodes = _ros_nodes()
    checks = {
        name: _check_state(name, running, nodes) for name in REQUIRED_CHECKS
    }
    report = {
        "mode": args.mode,
        "project": COMPOSE_PROJECT,
        "checks": checks,
        # 어느 층이 책임지는 점검인지 함께 알려 준다.
        "layers": {
            "docker": sorted(DOCKER_CHECKS),
            "host_ros": sorted(ROS_CHECKS),
        },
        # 시뮬레이션은 fake 모델 계약만 확인한다. 실제 checkpoint는 P1이다.
        "act_contract": "deterministic_fake",
        "ai_5080_started": False,
        "healthy": all(state == "healthy" for state in checks.values()),
    }
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0 if report["healthy"] else 1


def _running_services(mode: str) -> dict[str, str]:
    if not _docker_available():
        return {}
    completed = _run(
        compose_command("ps", "--format", "json", mode=mode), capture=True
    )
    if completed.returncode != 0 or not completed.stdout.strip():
        return {}
    states: dict[str, str] = {}
    for line in completed.stdout.splitlines():
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue
        name = record.get("Service") or record.get("Name")
        if name:
            states[name] = str(record.get("Health") or record.get("State") or "")
    return states


def _ros_nodes() -> list[str]:
    """호스트에서 보이는 ROS 2 노드 목록. ROS 환경이 없으면 빈 목록이다."""
    if shutil.which("ros2") is None:
        return []
    completed = _run(["ros2", "node", "list"], capture=True)
    if completed.returncode != 0:
        return []
    return [line.strip() for line in completed.stdout.splitlines() if line.strip()]


def _check_state(check: str, running: dict[str, str], nodes: list[str]) -> str:
    if check in DOCKER_CHECKS:
        state = running.get(DOCKER_CHECKS[check])
        if state is None:
            return "absent"
        return "healthy" if state in ("healthy", "running") else state
    marker = ROS_CHECKS.get(check)
    if marker is None:
        return "unknown"
    return "healthy" if any(marker in node for node in nodes) else "absent"


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="control_stack", description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    def add_mode(target: argparse.ArgumentParser) -> None:
        target.add_argument("--mode", default="simulation", choices=("simulation",))

    up = subparsers.add_parser("up", help="start the whole P0 stack in order")
    add_mode(up)
    up.add_argument("--project", default="trihouse_test_01")
    up.add_argument("--gui", action="store_true", help="show the Gazebo GUI")
    up.add_argument("--rviz", action="store_true", help="also start RViz")
    up.add_argument(
        "--build",
        action="store_true",
        help="rebuild the locally built images before starting them",
    )
    up.set_defaults(handler=cmd_up)

    status = subparsers.add_parser("status", help="show container status")
    add_mode(status)
    status.set_defaults(handler=cmd_status)

    logs = subparsers.add_parser("logs", help="show recent logs")
    add_mode(logs)
    logs.add_argument("--tail", default=200, type=int)
    logs.add_argument("--follow", action="store_true")
    logs.set_defaults(handler=cmd_logs)

    doctor = subparsers.add_parser("doctor", help="report every required check")
    add_mode(doctor)
    doctor.set_defaults(handler=cmd_doctor)

    down = subparsers.add_parser("down", help="stop the docker layer")
    add_mode(down)
    down.set_defaults(handler=cmd_down)

    ros = subparsers.add_parser("ros", help="start the host ROS 2 layer")
    add_mode(ros)
    ros.add_argument("--project", default="trihouse_test_01")
    ros.add_argument("--gui", action="store_true", help="show the Gazebo GUI")
    ros.add_argument("--rviz", action="store_true", help="also start RViz")
    ros.add_argument("--fms-base-url", default="http://127.0.0.1:8080")
    ros.set_defaults(handler=cmd_ros)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return args.handler(args)


if __name__ == "__main__":
    raise SystemExit(main())
